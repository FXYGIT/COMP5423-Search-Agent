# 统一配置：系统环境变量优先于 .env，空可选项使用代码默认值。
# 所有相对路径都以启动命令时的当前目录为基准。

# LLM（仅真实 Agent 调用需要；离线复评不需要）
LLM__API_KEY=
LLM__BASE_URL=
# 填写服务商提供的 DeepSeek-V4-Flash 模型 ID；不假定不同网关的 ID 相同。
LLM__MODEL=
LLM__TIMEOUT_SECONDS=120
LLM__MAX_RETRIES=2

# Embedding：填写本地路径或模型名；建库、检索、评估共用。
# DENSE_MODEL 用于 encoder；INSTRUCTION_MODEL 用于指令嵌入。
EMBEDDING__DENSE_MODEL=
EMBEDDING__INSTRUCTION_MODEL=
EMBEDDING__DEVICE=cpu
EMBEDDING__BATCH_SIZE=64
EMBEDDING__NORMALIZE=true
EMBEDDING__QUERY_INSTRUCTION=Find evidence answering the query.

# Chroma：不同模型使用不同集合
CHROMA__PATH=./chroma
CHROMA__DENSE_COLLECTION=browsecomp_dense
CHROMA__INSTRUCTION_COLLECTION=browsecomp_instruction

# 检索：sparse / dense / instruction / hybrid
RETRIEVAL__METHOD=hybrid
RETRIEVAL__TOP_K=5
RETRIEVAL__SPARSE_INDEX_PATH=./indexes/bm25
RETRIEVAL__RRF_CONSTANT=60

# 建库：encoder / instruction；两类模型分别建库
INDEXING__CATEGORY=encoder
INDEXING__CHUNK_SIZE=1500
INDEXING__CHUNK_OVERLAP=200
# 留空表示完整语料
INDEXING__LIMIT_DOCUMENTS=

# 原文访问
DOCUMENT__CORPUS_PATH=./data/browsecomp_plus_corpus
DOCUMENT__MAX_CHARS=4000

# 技能：ROOT 留空使用包内 builtin 目录
SKILLS__ROOT=
SKILLS__TIMEOUT_SECONDS=30

# 上下文：MAX_TOKENS 包含 system、工具定义及输出预留。
# 预算是本地估算，不是 DeepSeek tokenizer 的精确计数；评估仅统计 API usage。
CONTEXT__MAX_TOKENS=16000
CONTEXT__SUMMARY_TRIGGER_TOKENS=12000
CONTEXT__RESERVE_OUTPUT_TOKENS=2000
CONTEXT__EVIDENCE_MAX_TOKENS=4000
CONTEXT__SUMMARY_MAX_TOKENS=1500
CONTEXT__SUMMARY_ENABLED=true

# 评估：无额外配置命令行参数；SPLIT 留空选择唯一 split，LIMIT 留空运行全部题目
EVALUATION__DATASET_PATH=./data/browsecomp_plus_val
EVALUATION__SPLIT=
EVALUATION__PREDICTIONS_PATH=./test_prediction.jsonl
EVALUATION__OUTPUT_DIR=.
EVALUATION__LIMIT=

# 全局 root logger：仅写文件，无控制台 handler
LOGGING__PATH=./logs/search_agent.log
LOGGING__LEVEL=INFO
